// ============================================================
// QUALITY INSPECTION (WEB) v4.0 — Prisma Schema
// Source of Truth: V4_MASTER_BLUEPRINT.md § 4 (Core Data Structures)
// ORM:      Prisma 7 (Early Access)
// Provider: SQLite (dev) — swap datasource.url for PostgreSQL in prod
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}


// ============================================================
// SUBMISSION
// Maps to: export interface Submission
// The central record of a single AQL inspection session.
// ============================================================
model Submission {
  /// Primary key — mirrors the `id: string` typed as 'sub_XXXXXXXXX'
  id                  String          @id @default(cuid())

  // --- Batch / Product Metadata ---
  productCode         String
  /// Full ISO 8601 datetime string (e.g. '2026-08-06T10:17:38.379Z') — the
  /// operator-editable effective production date/time used to derive the
  /// lot number's YJJJ component (ISO2859_MATH_ENGINE.md §4), NOT a bare
  /// date-only string despite the field name.
  productionDate      String
  /// Full ISO 8601 datetime string, same shape as productionDate — NOT a
  /// bare "HH:MM" string despite the field name. Usually equal to
  /// productionDate; can differ when the operator edits one without the
  /// other (e.g. amendment mode).
  samplingTime        String
  submissionTimestamp String          // ISO 8601 with ms precision, set by server
  machineId           String
  shift               String
  /// Full System Lot Number: [Line] + [Side] + [YJJJ] + [Sequence]
  /// (ISO2859_MATH_ENGINE.md §4), e.g. 'A001Z6221007'. Composed client-side
  /// from operator-selected Line/Side + the editable production date +
  /// a required, operator-entered Sequence (never auto-defaulted or
  /// auto-incremented — see StepMetadata.tsx/BatchEntry.tsx). This is NOT
  /// invented by the app: it must match what the company's ERP separately
  /// registers for the same physical lot, so composition is a convenience,
  /// not a guess. @unique is enforced here as the authoritative backstop
  /// behind the app-level uniqueness check in submissions.routes.ts.
  batchNumber         String          @unique
  size                String          // Glove size: 'XS' | 'S' | 'M' | 'L' | 'XL'
  sampleSize          Int

  // --- Measurement Data (stored as JSON blobs) ---
  // Raw per-slot measurement strings entered via numpad, keyed by dynamic
  // dimension id (not a fixed thickness/length shape — see ProductDimensionDef).
  dimensions          String          // JSON — DimensionMeasurements = Record<string, string[]>

  // Despite the name, stores the full per-dimension stats object (min/max/avg/
  // fails/thresholds) computed client-side at measurement time, NOT minimums —
  // legacy field name kept for backward compatibility. See DATA_SCHEMAS_AND_TYPES.md
  // §1 DimensionStats / AUDIT_REPORT.md §5.11.
  dimensionMins       String          // JSON — DimensionStats

  // DefectCounts: Record<DefectId, number>
  defects             String          // JSON — Record<string, number>

  // --- Verdict & Compliance ---
  verdict             String          // 'PASSED' | 'FAILED'

  // --- Submitting-user identity (mixed model) ---
  // Exactly ONE side is populated per row, decided by the login method that
  // created it: a PIN login sets `pinUserId` (a real FK); an M365/SSO login
  // sets the three string fields below. Both sides are nullable because
  // neither applies universally. Rows created before this model existed have
  // the SSO strings populated with hardcoded placeholder literals and
  // `pinUserId` null — deliberately left untouched, not backfilled.

  /// Azure AD Object ID from the MS365 token — SSO-originated rows only.
  aadObjectId         String?
  /// UPN (email) from the MS365 token — SSO-originated rows only. Always a
  /// true UPN/email, never a display name (see `displayName` below).
  userPrincipalName   String?
  /// Human-readable name of the SSO user, captured at submit time so history
  /// stays readable without a live Azure AD lookup. Kept separate from
  /// `userPrincipalName` so that field keeps meaning strictly "the UPN".
  /// SSO-originated rows only — for PIN rows the name comes from PinUser.name.
  displayName         String?

  /// FK to the PinUser who submitted — PIN-originated rows only.
  pinUserId           String?
  pinUser             PinUser?        @relation("SubmissionPinUser", fields: [pinUserId], references: [id])

  // --- Amendment Workflow ---
  amendmentStatus     String          @default("UNMODIFIED")
  // AmendmentStatus: 'UNMODIFIED' | 'AMENDMENT_DRAFTED' | 'PENDING_APPROVAL' | 'APPROVED' | 'REJECTED'

  // --- Optional Fields ---
  totalCarton         Int?
  gloveWeight         Float?

  // --- Profile Reference ---
  /// Opaque historical reference to whichever profile was in effect at submit
  /// time. Points at Profile.id as of Stage A0 (before that, at an entry in the
  /// since-dropped AppConfig.inspectionProfiles JSON array — the id strings are
  /// the same either way, which is why no data migration was needed). Still NO
  /// enforced referential integrity: the FK relation to a dedicated
  /// InspectionProfile table was removed deliberately (AUDIT_REPORT.md §8.4/
  /// §9.3 Option B / §10 Part 3), and Stage A0 did not reinstate one — a
  /// historical submission must survive its profile being deleted.
  profileId           String?

  /// Full per-category AQL analysis frozen at submit time (or refrozen at
  /// amendment-approval time, in the same transaction as `verdict`) — a
  /// self-contained snapshot, no live profile lookup needed to render it.
  /// JSON — FrozenCategoryAnalysis[] (backend/src/engine/resolveVerdict.ts).
  /// Null on rows predating this field ("legacy") — deliberately NOT
  /// backfilled (see AUDIT_REPORT.md finding #18); HistoryFeed.tsx falls
  /// back to a live re-grade with an explicit warning label for those.
  gradingSnapshot            String?
  /// Resolved profile display name captured at freeze time, so the panel
  /// can render it without a live profile lookup. Always set together
  /// with gradingSnapshot (both null or both set).
  gradingSnapshotProfileName String?

  /// Frozen Glove Weight compliance result — a single DimensionResult (JSON,
  /// backend/src/engine/dimensionEvaluator.ts), computed once by
  /// evaluateWeight() at submit time (or refrozen at amendment-approval time,
  /// in the same transaction as gradingSnapshot/verdict). Closes a gap
  /// `dimensionMins` never covered: that field is the CLIENT's own computed
  /// stats object and never included Glove Weight (a scalar, not a 5-slot
  /// measurement) — so before this field existed, Weight's compliance had no
  /// frozen record at all, only a live recompute against whatever
  /// weightTarget/weightTolerance the product config happens to hold NOW.
  /// Same "frozen once, never recomputed" rule as gradingSnapshot, including
  /// null on rows predating this field ("legacy") — deliberately NOT
  /// backfilled, same rationale as AUDIT_REPORT.md finding #18.
  gloveWeightSnapshot        String?

  // --- Relations ---
  amendmentLogs       AmendmentLog[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([productCode])
  @@index([submissionTimestamp])
  @@index([machineId, shift])
  @@index([amendmentStatus])
  @@index([pinUserId])
}

// ============================================================
// AMENDMENT LOG
// Maps to: export interface AmendmentLog (implied by Submission.amendmentLogs)
// An immutable audit trail entry for every change made after submission.
// ============================================================
model AmendmentLog {
  id              String      @id @default(cuid())

  submissionId    String
  submission      Submission  @relation(fields: [submissionId], references: [id])

  /// Serialized JSON snapshot of the original field values before the amendment
  originalValues  String      // JSON — Partial<Submission>

  /// Serialized JSON snapshot of the proposed new field values
  newValues       String      // JSON — Partial<Submission>

  // --- Requester identity (mixed model — see Submission's identity block) ---
  // Exactly one side is populated: `requestedByPinUserId` for a PIN login, or
  // `requestedBy`/`requestedByDisplayName` for an M365/SSO login.

  /// Who authored the amendment draft — true UPN/email, SSO-originated only.
  requestedBy     String?
  /// Human-readable name of the SSO requester, captured at draft time.
  requestedByDisplayName String?
  /// FK to the PinUser who authored the draft — PIN-originated only.
  requestedByPinUserId   String?
  requestedByPinUser     PinUser? @relation("AmendmentRequestedByPinUser", fields: [requestedByPinUserId], references: [id])
  requestedAt     String      // ISO 8601 timestamp

  // --- Reviewer identity (same mixed model as the requester above) ---

  /// Who approved or rejected — true UPN/email, SSO-originated only.
  reviewedBy      String?
  /// Human-readable name of the SSO reviewer, captured at review time.
  reviewedByDisplayName  String?
  /// FK to the PinUser who reviewed — PIN-originated only.
  reviewedByPinUserId    String?
  reviewedByPinUser      PinUser? @relation("AmendmentReviewedByPinUser", fields: [reviewedByPinUserId], references: [id])
  reviewedAt      String?     // ISO 8601 timestamp

  /// 'PENDING_APPROVAL' | 'APPROVED' | 'REJECTED'
  status          String      @default("PENDING_APPROVAL")

  /// Optional notes/reason supplied by the Supervisor
  supervisorNote  String?

  /// Server-recomputed verdict via resolveVerdict() — 'PASSED' | 'FAILED'.
  /// Set at draft time (informational) and overwritten at approval time
  /// (authoritative — this is what actually gets persisted to Submission.verdict).
  /// Null on rows created before this audit trail existed.
  recomputedVerdict          String?

  /// JSON — CategoryResult[] audit breakdown backing recomputedVerdict.
  recomputedCategoryResults  String?

  /// Count of physical dimensions with at least one out-of-spec measurement
  /// slot, from the server-side dimension recompute (§5.9 fix) — folded into
  /// recomputedVerdict via (AQL FAILED) OR (recomputedFailedDimensions > 0).
  /// Null on rows created before this audit trail existed.
  recomputedFailedDimensions Int?

  /// JSON — DimensionResult[] audit breakdown explaining recomputedFailedDimensions,
  /// same role as recomputedCategoryResults but for the dimension half of the verdict.
  recomputedDimensionResults String?

  createdAt       DateTime    @default(now())

  @@index([submissionId])
  @@index([requestedByPinUserId])
  @@index([reviewedByPinUserId])
}

// ============================================================
// InspectionProfile / AQLCategory / DefectDefinition models removed
// (AUDIT_REPORT.md §9.3 Option B / §10 Part 3) — they sat fully unused
// (0 rows) since real profile/category/defect data has only ever lived
// in AppConfig.inspectionProfiles JSON. See AUDIT_REPORT.md §8.4/§9.3 for
// the effort/tradeoff analysis behind this decision.
// ============================================================

// ============================================================
// PIN USER
// Self-managed PIN logins for high-turnover floor staff who don't have
// company email/Microsoft accounts (AUDIT_REPORT.md §11). Group A/B
// (managers) create and deactivate these; the PIN itself authenticates
// via POST /api/auth/pin-login. `role` is restricted server-side to the
// three PIN-eligible roles (OPERATOR/LEADER/SUPERVISOR — the "no email" /
// "PIN fallback" roles per NAVIGATION_AND_RBAC.md §2); `jobTitle` is the
// free-text real title, kept separate from `role` so audit trails retain
// the real title rather than collapsing it down to the role/group.
// ============================================================
model PinUser {
  id        String   @id @default(cuid())
  name      String
  /// Company-assigned employee ID — a second identity key alongside `id`,
  /// required + globally unique (@unique enforced at the DB level, mirrors
  /// Submission.batchNumber's two-layer pattern: app-level findFirst
  /// pre-check backed by this constraint as the atomic race-condition
  /// backstop — see pinUsers.routes.ts). Always stored uppercase (no
  /// enforced format/pattern — different customers use different employee
  /// ID schemes). Editable after creation by Group A/B via PATCH
  /// /api/pin-users/:id — the sole exception to PinUser's otherwise
  /// deliberate no-edit rule (NAVIGATION_AND_RBAC.md); never editable by
  /// the PIN user themselves (they have no authenticated session that
  /// reaches this route).
  employeeId String  @unique
  jobTitle  String
  /// 'OPERATOR' | 'LEADER' | 'SUPERVISOR' | 'INTERN' — enforced in route validation, not the DB
  role      String

  /// scrypt hash of the 6-digit PIN — see backend/src/lib/pin.ts
  pinHash   String
  /// Per-record random salt used to compute pinHash
  pinSalt   String

  /// Deactivated users are kept (not deleted) for audit history. PIN
  /// uniqueness is deliberately NOT enforced (login is identity-first —
  /// the worker picks their own account from a directory before entering a
  /// PIN, so two staff sharing a PIN is unambiguous and harmless — see
  /// pinUsers.routes.ts's POST /api/auth/pin-login).
  active    Boolean  @default(true)

  /// True until the PIN holder sets their own PIN via POST /api/auth/pin-change
  /// (which clears it) — forces frontend/src/pages/SetPinPage.tsx before any
  /// other route, so an ADMIN/MANAGER-chosen PIN (at creation, via
  /// POST /api/pin-users, or at reset, via PATCH /:id/reset-pin — both of
  /// which set this back to true) is only ever a one-time temp credential,
  /// never the account's actual working PIN. Defaults true so brand-new
  /// accounts are covered with no extra route code — EXISTING rows as of
  /// this field's introduction were explicitly backfilled to false
  /// (scripts/backfill-must-change-pin.ts) so current staff are never
  /// retroactively forced through the gate for a PIN they already own.
  mustChangePin Boolean @default(true)

  // --- Back-relations (required by Prisma for the named relations below) ---
  // These make PIN-originated work attributable to a real person. Never
  // include these (or this model) in an API response without an explicit
  // `select` — PinUser carries pinHash/pinSalt, which must never be
  // serialized to a client.
  submissions       Submission[]   @relation("SubmissionPinUser")
  amendmentRequests AmendmentLog[] @relation("AmendmentRequestedByPinUser")
  amendmentReviews  AmendmentLog[] @relation("AmendmentReviewedByPinUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// ============================================================
// M365 USER ROLE
// aadObjectId -> role mapping for real Entra ID SSO logins (Group A/B/C —
// ADMIN/MANAGER/SUPERVISOR). A row can now be created two ways:
// auto-provisioned with role: null on a user's first successful MSAL
// login (POST /api/auth/m365-login), or pre-registered by a Group A admin
// via POST /api/m365-users/invite (role set, aadObjectId null, claimed on
// that person's first login). An admin (Group A, /system) assigns/changes
// a role via PATCH /api/m365-users/:id. Mirrors the PinUser pattern but
// for SSO users, who have no PinUser row of their own.
//
// State model — (aadObjectId, role, isActive) fully and unambiguously
// distinguish every reachable state, no separate status field needed:
//   aadObjectId set,  role null,     isActive true  → pending (Access Pending screen)
//   aadObjectId null, role set,      isActive true  → invited, not yet claimed
//   aadObjectId null, role set,      isActive false → invite revoked before claim
//   aadObjectId set,  role set,      isActive true  → fully active assigned user
//   aadObjectId set,  role set,      isActive false → deactivated
// (aadObjectId null + role null is never written by any code path.)
// ============================================================
model M365UserRole {
  id                String   @id @default(cuid())
  /// Null for an invited-but-unclaimed row (pre-registered by email, no
  /// login yet); set on that person's first login (claims the invite) or
  /// immediately for a never-invited first-time login. SQLite/libsql permit
  /// multiple NULLs under a UNIQUE index, so any number of unclaimed
  /// invited rows can coexist without collision.
  aadObjectId       String?  @unique
  /// Globally unique — the one field that identifies a person before
  /// they've ever logged in (invited row) as well as after.
  userPrincipalName String   @unique
  displayName       String
  /// Real job title from Microsoft Graph (GET /v1.0/me?$select=jobTitle),
  /// captured/refreshed on every login the same way displayName already
  /// is — display/audit only, NEVER read by any permission check (same
  /// rule as PinUser.jobTitle, NAVIGATION_AND_RBAC.md). Null for an
  /// unclaimed invite (never logged in yet, no Graph data) or if Graph
  /// genuinely never returned one; a transient Graph failure on a later
  /// login never blanks out a previously captured value — the route only
  /// overwrites this field when the incoming login actually supplies one.
  jobTitle          String?

  /// null = pending assignment (no access yet, only reachable via a bare
  /// first login, never via invite). 'ADMIN' | 'MANAGER' | 'SUPERVISOR'
  /// once set — enforced in route validation, not the DB (same convention
  /// as PinUser.role).
  role              String?

  /// Mirrors PinUser.active. False = access revoked (a claimed user who
  /// was deactivated) or an invite revoked before it was ever claimed.
  /// Distinct from role: null ("never assigned yet") — isActive false
  /// means "was/would-be granted a role, but access is off right now."
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

// ============================================================
// APP CONFIG
// Maps to: export interface AppConfig
// A SINGLETON table (only one row should ever exist).
// Stores all dynamic, hot-swappable system configuration.
// Lists and SKU builder dictionaries are stored as JSON blobs.
// ============================================================
model AppConfig {
  /// Singleton sentinel — always '1'
  id                  String   @id @default("1")

  // --- Simple string/number array lists (stored as JSON) ---
  /// JSON: string[] — e.g., ['N035SKB-OC-24FT', 'N100FNB-EC-9.5IN']
  productCodes        String   @default("[]")

  /// JSON: { id: string; name: string }[]
  lines               String   @default("[]")

  /// JSON: { id: string; name: string }[]
  shifts              String   @default("[]")

  /// JSON: { id: string; name: string }[]
  sides               String   @default("[]")

  /// JSON: string[] — e.g., ['XS', 'S', 'M', 'L', 'XL']
  sizes               String   @default("[]")

  /// JSON: number[] — valid AQL sample sizes, e.g. [13, 20, 32, 50, 80, 125, 200]
  sampleSizes         String   @default("[]")

  // --- Product to Profile Mapping ---
  /// JSON: Record<productCode, profileId>
  productProfileMap   String   @default("{}")

  // --- Branding (Blueprint Section 8: Dynamic White-Label) ---
  /// Company display name, e.g., 'GLOVE CORP'
  companyName         String   @default("QUALITY INSPECTION")
  /// Portal tab title
  portalTitle         String   @default("QI Portal v4.0")
  /// Base64 or URL of corporate logo
  logoImage           String?
  /// Primary accent colour token — one of the 5 named presets in
  /// frontend/src/lib/accentColors.ts: 'cobalt' | 'emerald' | 'violet' |
  /// 'amber' | 'rose'. Default is 'cobalt', not 'emerald' — matches the
  /// app's actual shipped visual identity (index.css's brand-primary/
  /// -secondary @theme values), so a fresh install with this field never
  /// explicitly set looks identical to today's app, not accidentally green.
  accentColor         String   @default("cobalt")

  // --- SKU Builder Dictionaries (Blueprint Section 5 / Section 7) ---
  /// JSON: { value: string; label: string }[]
  skuMaterials        String   @default("[]")
  /// JSON: { value: string; label: string }[]
  skuWeights          String   @default("[]")
  /// JSON: { value: string; label: string }[]
  skuColors           String   @default("[]")
  /// JSON: { value: string; label: string }[]
  skuTreatments       String   @default("[]")
  /// JSON: { value: string; label: string }[]
  skuLengths          String   @default("[]")
  /// JSON: { value: string; label: string }[]
  skuTextures         String   @default("[]")

  // --- Dynamic Configuration Data ---
  dimensions          String   @default("[]")
  targetWeight        String   @default("{\"target\":0,\"tolerance\":0}")
  productMatrixConfig String   @default("{}")
  aqlCategories       String   @default("[]")
  defectDefinitions   String   @default("[]")
  // `inspectionProfiles String @default("[]")` was DROPPED here at Stage B.
  // Profile IDENTITY now lives in the Profile model; grading RULES live in
  // Category / Defect / ProfileCategory / ProfileCategoryDefect. Nothing had
  // read the column since Stage A0 and nothing had written it since Stage A,
  // so it was dropped rather than left frozen.
  //
  // The API contract did NOT move: PATCH /api/config still ACCEPTS an
  // `inspectionProfiles` key (it is syncProfileRegistry()'s input) and GET
  // /api/config still RETURNS one, rebuilt from the tables above by
  // reconstructInspectionProfiles() in routes/config.routes.ts. Only the
  // storage column is gone.

  // --- Consolidated Product Record (additive, Session A — see Product Engine
  // discovery report §2/§5 and the productProfileMap corrupted-key incident
  // in CHANGELOG.md). Migrates the three independently-keyed structures
  // above (productCodes / productMatrixConfig / productProfileMap) plus the
  // six SKU dictionary attributes (previously discarded after composing the
  // code string) into ONE per-code record, eliminating the three-way drift
  // risk. Additive only: nothing reads from this field yet — the three
  // structures above remain the live source of truth until a later session
  // rewires call sites onto this one and removes them. ---
  /// JSON: Record<productCode, ProductEntry> — see DATA_SCHEMAS_AND_TYPES.md §3.
  products            String   @default("{}")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // --- Cross-user runtime state (not "configuration" in the editable-by-
  // admin sense, but piggybacks on this table since it's the only global
  // singleton — see GET/POST /api/submissions/new-indicator|mark-history-viewed) ---
  /// Global (not per-user) — last time ANY user viewed Inspection Records.
  /// Compared against Submission.createdAt to drive the sidebar "new lot"
  /// dot + row badges; a new calendar day also implicitly clears it (see
  /// GET /api/submissions/new-indicator's effectiveLastViewedAt calc).
  lastHistoryViewedAt DateTime?
}

// ============================================================
// ACCESS LOG
// Audit trail for logins (M365 + PIN) and configuration writes. Written
// from three call sites — m365Users.routes.ts's POST /m365-login,
// pinUsers.routes.ts's POST /pin-login, and config.routes.ts's
// PATCH /api/config — via the shared backend/src/lib/accessLog.ts helper.
// Read-only surface: GET /api/access-log (Group A only, System Admin).
// ============================================================
model AccessLog {
  id        String   @id @default(cuid())

  /// Resolved identity for the event — the AAD object id for an M365 row,
  /// or PinUser.id for a PIN row. Nullable: a failed M365 login before
  /// identity resolution (malformed request), or a PIN login attempt
  /// against an unknown/inactive userId, may not resolve to a real user.
  userId    String?
  /// 'OPERATOR' | 'LEADER' | 'SUPERVISOR' | 'INTERN' | 'MANAGER' | 'ADMIN' —
  /// same nullability reasoning as userId (some M365 states, e.g. a pending
  /// or bootstrap-eligible login, genuinely have no role assigned yet).
  role      String?
  /// Human-readable name, copied in at the moment of the write — same
  /// convention as AmendmentLog.requestedByDisplayName (schema.prisma), not
  /// a live join. Keeps the log's display accurate even if the person is
  /// later renamed/deleted, and avoids a runtime join on this table. Same
  /// nullability reasoning as userId/role — a failed login before identity
  /// resolution may not have a name to attach.
  userDisplayName String?
  /// 'M365_LOGIN_SUCCESS' | 'M365_LOGIN_FAILURE' | 'PIN_LOGIN_SUCCESS' |
  /// 'PIN_LOGIN_FAILURE' | 'CONFIG_WRITE' — enforced in route code, not the DB.
  action    String
  /// CONFIG_WRITE only — a short label of the configuration section touched
  /// (e.g. "Product Engine"), derived from which top-level AppConfig fields
  /// the PATCH payload supplied. Not a diff — see config.routes.ts's
  /// inferConfigWriteDetail().
  detail    String?
  ipAddress String?

  timestamp DateTime @default(now())

  @@index([timestamp])
}

// ============================================================
// MASTER DEFECT LIST + CATEGORY INVENTORY  (Stage 1 — additive only)
//
// Four models introducing a GLOBAL defect/category vocabulary that
// profiles select from, replacing the per-profile free-text model where
// every profile invented (and independently spelled) its own defects.
//
// ── These are now the LIVE grading tables (Stage 1 → 2 → A0 → A → B) ─
// Introduced ADDITIVE-ONLY at Stage 1, alongside an AppConfig.inspectionProfiles
// JSON blob that was then still authoritative. That is no longer the case:
//   Stage 2  — aqlEvaluator.ts / resolveVerdict.ts rewired onto these tables
//              (via engine/profileRules.ts); they became the grading authority.
//   Stage A0 — profile IDENTITY moved to the Profile model below.
//   Stage A  — PATCH /api/config stopped writing the JSON column.
//   Stage B  — the AppConfig.inspectionProfiles column was dropped outright.
// These tables are the sole source of truth for grading, maintained by
// syncProfileRegistry() (lib/profileRegistrySync.ts) on every profile write.
// The one-off Stage 1 backfill script that originally seeded them has been
// deleted; it was spent, and post-Stage-A could only have read a stale blob.
//
// ── Why these are the FIRST relational profile-adjacent models ──────
// InspectionProfile/AQLCategory/DefectDefinition were deliberately DELETED
// (AUDIT_REPORT.md §9.3 Option B) because they sat at 0 rows while all real
// data lived in AppConfig JSON. These models are not a revival of that set:
// they store the GLOBAL vocabulary (which did not exist before) plus the
// per-profile selection of it, which is genuinely relational data that the
// JSON blob modelled badly. Profiles themselves still live in the JSON —
// see the `profileId` note below.
// ============================================================

// ============================================================
// DEFECT — the global Master Defect List
//
// One row per canonical defect name in the whole system. A profile does not
// own defects any more; it SELECTS them (see ProfileCategoryDefect).
// ============================================================
model Defect {
  /// CANONICAL IDENTITY — deliberately the EXISTING `def_*` slug
  /// (e.g. 'def_wet_glove_1'), never a newly minted key.
  ///
  /// This is load-bearing, not cosmetic. `Submission.defects` is
  /// Record<defectId, count> and `Submission.gradingSnapshot`'s
  /// defectItems[].id both store these exact strings on 27 existing rows.
  /// POST /api/amendments/:id/approve re-grades by feeding those stored
  /// keys back through resolveVerdict() against the CURRENT definitions —
  /// so re-IDing a defect would make every lookup miss, silently resolve
  /// each count to 0 via `defectCounts[def.id] ?? 0`, and could flip a
  /// stored verdict FAILED -> PASSED while overwriting the original
  /// gradingSnapshot. Preserving these ids is what makes this migration
  /// safe. See the Stage 1 discovery report, trap G8-1.
  id        String   @id

  /// Human-readable display code ('DEF-001'). PURELY COSMETIC — for the
  /// picker modal and admin screens. NEVER used as a lookup key by the
  /// engine, by any grading path, or by any stored submission data.
  /// Assigned once at backfill (alphabetically by name, so the initial
  /// numbering is deterministic and reproducible) and stable thereafter;
  /// defects added later take the next free number rather than causing a
  /// renumber, since a code that moves is worse than a code with a gap.
  code      String   @unique

  /// Display name, in the casing the admin authored ('Wet Glove').
  name      String

  /// Normalized form of `name` — trim -> lowercase -> collapse internal
  /// whitespace. Mirrors normalizeDefectName() in QualityRules.tsx exactly,
  /// which is the rule the admin UI has always applied when rejecting a
  /// duplicate. Stored (rather than computed at query time) purely so the
  /// @unique below can enforce that rule at the DB level: SQLite's UNIQUE is
  /// case-SENSITIVE, so a bare `name @unique` would happily admit both
  /// 'Wet Glove' and 'wet glove'. Two-layer pattern, same as
  /// Submission.batchNumber / PinUser.employeeId — app-level check in front,
  /// DB constraint as the atomic backstop.
  ///
  /// Note this constraint is GLOBAL, inverting the old per-profile rule
  /// (findDuplicateDefectName() checked only the active profile, with an
  /// explicit comment that "a name may legitimately repeat across profiles").
  /// That is the whole point of a master list.
  nameKey   String   @unique

  profileLinks ProfileCategoryDefect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// CATEGORY — the global Category Inventory
//
// A SUPERSET, not a forced-identical set. FACTORY STANDARD's single VISUALS
// bucket and MEDLINE's three-tier VISUAL — CRITICAL/MAJOR/MINOR ladder are
// genuinely different grading regimes and are preserved as DISTINCT rows;
// they are deliberately NOT collapsed into each other. Each profile picks
// its own subset via ProfileCategory.
// ============================================================
model Category {
  /// CANONICAL IDENTITY — the existing category id, preserved verbatim
  /// ('AND', 'BARRIER', 'cat_1787208360393', 'VISUAL_MAJOR', ...).
  /// Same preservation rule as Defect.id: gradingSnapshot freezes category
  /// ids too, and buildFrozenCategoryAnalysis() joins defects to categories
  /// on them.
  id             String   @id

  /// Human-readable display code ('CAT-001'). Cosmetic only, same contract
  /// as Defect.code. Backfill assigns these in first-appearance order across
  /// profiles (FACTORY STANDARD's set, then MEDLINE's additions), which keeps
  /// the two universally-shared categories as CAT-001/CAT-002 and each
  /// profile's own set contiguous — more meaningful for an 8-row structural
  /// inventory than alphabetical would be.
  code           String   @unique

  name           String

  /// Same normalize-and-enforce contract as Defect.nameKey.
  nameKey        String   @unique

  profileLinks   ProfileCategory[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================
// PROFILE ↔ CATEGORY
// Which global categories a profile uses, and at what AQL level.
//
// AQL is stored HERE, not on Category, because it is a per-profile setting
// by design: FACTORY STANDARD and MEDLINE both use the global BARRIER
// category, and two profiles may legitimately grade the same category at
// different AQL levels (MEDLINE's VISUAL — CRITICAL at 1.0 vs its MINOR at
// 4.0 is the same shape of decision).
// ============================================================
model ProfileCategory {
  id         String   @id @default(cuid())

  /// Opaque reference to a Profile.id — still NOT a declared foreign key.
  /// Originally loose because profiles were JSON rather than a table; since
  /// Stage A0 gave them one, the looseness is a deliberate carry-over of the
  /// same convention as Submission.profileId rather than a limitation (see
  /// the Profile model's "No FK from ProfileCategory.profileId" note). No
  /// enforced referential integrity, so a deleted profile would leave rows
  /// behind here — syncProfileRegistry() prunes them instead.
  profileId  String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  /// The AQL level string as the engine consumes it — 'AND', '1.0', '2.5',
  /// '4.0', 'PASS/FAIL', 'RECORD ONLY'. Deliberately a String, not a
  /// number/enum: getAQLThresholds() takes a string and routes non-numeric
  /// values ('AND', anything matching the zero-tolerance test) down a
  /// different path entirely, and 'RECORD ONLY'/'PASS/FAIL' are display
  /// labels for categories that never reach the ISO matrix at all.
  aqlLevel   String

  /// How the engine grades this category IN THIS PROFILE. CLEAN ENUM FORM —
  /// one of:
  ///   'CUMULATIVE'  — sum all defect counts in the category, FAIL if > Ac
  ///   'GRANULAR'    — each defect type checked independently against Ac
  ///   'QUALITATIVE' — pass/fail items; counts are state codes (0/1/2)
  ///   'RECORD_ONLY' — informational; the engine skips the category entirely
  ///
  /// Lives HERE, not on Category, for the same reason aqlLevel does: how a
  /// category is graded is a decision the adopting PROFILE makes, not a
  /// permanent property of the name. A global Category is a name and nothing
  /// else — exactly symmetric with Defect — so two profiles may legitimately
  /// use the same category under different modes. (No profile pair does today:
  /// AND and BARRIER are shared by FACTORY STANDARD and MEDLINE and both grade
  /// them CUMULATIVE.)
  ///
  /// ⚠ THIS IS NOT THE WIRE FORMAT THE ENGINE READS. AppConfig JSON and
  /// aqlEvaluator.ts use a different dialect, and the mapping is NOT
  /// lossless-by-coincidence — it must be applied deliberately in both
  /// directions:
  ///
  ///     this field      AppConfig JSON / engine `evaluationMode`
  ///     ───────────     ────────────────────────────────────────
  ///     CUMULATIVE  <->  'CUMULATIVE'
  ///     GRANULAR    <->  'GRANULAR'
  ///     QUALITATIVE <->  'N/A'
  ///     RECORD_ONLY <->  ''          ← empty string, NOT null/undefined
  ///
  /// The last row is the dangerous one. `''` is a REAL, DELIBERATE value —
  /// it is the ONLY thing that triggers aqlEvaluator.ts's true-exclusion path
  /// (`if (!category.evaluationMode) continue;`), and defaultProfileSeed.ts
  /// documents it as EMPTY_EVAL_MODE_IS_RECORD_ONLY with isEvalModeUnset()
  /// using `??` rather than `||` precisely so it is never coerced away. A
  /// mapper that turns RECORD_ONLY back into null, undefined, or 'CUMULATIVE'
  /// would either be rejected by validateInspectionProfiles() or — worse —
  /// start grading a record-only category, failing lots on defects that were
  /// never meant to count. def_sagging already sits in FACTORY STANDARD's
  /// RECORD ONLY category in a real frozen submission.
  ///
  /// Deliberately NO @default: a silent fallback here is precisely how a
  /// RECORD_ONLY category would quietly become graded. Every writer must
  /// state the mode explicitly.
  ///
  /// The canonical mapping lives in code at
  /// backend/src/lib/categoryEvaluationMode.ts — use it, never re-derive it.
  evaluationMode String

  /// Preserves the admin-authored ordering of categories within the profile,
  /// captured from the existing JSON array index. Not decoration — the admin
  /// UI renders categories in array order today, so dropping it would
  /// silently reshuffle every profile screen at Stage 2.
  sortOrder  Int

  defects    ProfileCategoryDefect[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([profileId, categoryId])
  @@index([profileId])
}

// ============================================================
// PROFILE ↔ CATEGORY ↔ DEFECT
// Which defects a profile records under which of its selected categories.
//
// Replaces DefectDefinition.categoryId: instead of each profile holding its
// own copy of a defect that happens to carry a category pointer, the profile
// holds a SELECTION linking one global Defect to one of its ProfileCategory
// rows. The FK to ProfileCategory (not a loose profileId+categoryId pair)
// makes it structurally impossible to file a defect under a category the
// profile has not selected.
// ============================================================
model ProfileCategoryDefect {
  id                String          @id @default(cuid())

  profileCategoryId String
  profileCategory   ProfileCategory @relation(fields: [profileCategoryId], references: [id], onDelete: Cascade)

  defectId          String
  defect            Defect          @relation(fields: [defectId], references: [id])

  /// DENORMALIZED from profileCategory.profileId — carried here for exactly
  /// one reason: it makes @@unique([profileId, defectId]) expressible, and
  /// that constraint enforces a real correctness invariant that cannot be
  /// stated on the parent. A defect must appear under AT MOST ONE category
  /// per profile, because both aqlEvaluator.ts and
  /// buildFrozenCategoryAnalysis() resolve a category's members by filtering
  /// the full defect list — a defect sitting in two categories would be
  /// counted twice, inflating a CUMULATIVE total and double-reporting in the
  /// frozen snapshot.
  ///
  /// The cost is a field that can drift from its parent. Every writer MUST
  /// set it from profileCategory.profileId, never independently.
  profileId         String

  /// Preserves the admin-authored order of defects within the category —
  /// the ordering handleMoveDefect() in QualityRules.tsx exists to let
  /// admins control. Captured from the existing JSON array index.
  sortOrder         Int

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([profileCategoryId, defectId])
  @@unique([profileId, defectId])
  @@index([defectId])
  @@index([profileId])
}

// ============================================================
// PROFILE — inspection profile IDENTITY  (Stage A0 — additive)
//
// The first relational home for a profile's IDENTITY: its id↔name mapping,
// the isDefault flag, and display ordering. Grading RULES (category
// selection, per-profile AQL levels + evaluation modes, defect membership)
// were already moved to Category / Defect / ProfileCategory /
// ProfileCategoryDefect at Stage 2 — this model only carries what those
// tables deliberately do NOT: the profile as a named, ordered thing.
//
// ── Why this exists ────────────────────────────────────────────────
// Post-Stage-2, AppConfig.inspectionProfiles JSON was redundant for RULES
// but was still the ONLY source of profile identity — the profileId→name
// lookup in resolveVerdict.ts, the "zero profiles exist" bootstrap signal,
// the submit-time isKnownProfileId() sanity check, and the reconstructed
// nested array in GET /api/config's formatAppConfig(). Stage A0 moved those
// four read paths onto this table; Stage A then retired the JSON write, and
// Stage B dropped the column. This table is now the only home for a profile's
// identity.
//
// ── No FK from ProfileCategory.profileId ───────────────────────────
// Deliberately left loose in this stage — same opaque-string convention as
// Submission.profileId (see that field's note). Tightening it into a real
// relation is out of scope here.
//
// ── Kept in sync ──────────────────────────────────────────────────
// Seeded once at Stage A0 by a one-off backfill script that read the identities
// out of the then-live JSON blob (script since deleted at Stage B, along with
// the column it read). Maintained ever since by syncProfileRegistry()
// (lib/profileRegistrySync.ts) on every PATCH /api/config profile write — the
// same hook, and the same payload.inspectionProfiles request-body key, that
// already projects the RULES tables. Rows for profiles no longer in the payload
// are pruned, mirroring the full-array-replace semantics the JSON blob had.
// ============================================================
model Profile {
  /// CANONICAL IDENTITY — the existing profileId string, preserved verbatim
  /// ('prof_default', 'prof_1787197871523', ...). Never minted fresh: these
  /// exact strings are stored on Submission.profileId and referenced by
  /// ProfileCategory.profileId / ProfileCategoryDefect.profileId.
  id        String   @id

  /// Display name ('FACTORY STANDARD', 'MEDLINE'), in the admin's casing.
  name      String

  /// The single profile the resolution chain falls back to when no explicit
  /// profileId is supplied and productProfileMap has no entry. Not enforced
  /// unique — the JSON blob never enforced "exactly one default" either, and
  /// the resolution order (explicit id → productProfileMap → first usable →
  /// hardcoded seed) does not actually depend on this flag today. Carried so
  /// the reconstructed GET response stays shape-identical.
  isDefault Boolean

  /// Admin-authored profile order, captured from the JSON array index. The
  /// admin UI (QualityRules.tsx) and the wizard dropdowns render profiles in
  /// this order, and resolveVerdict.ts's safety net scans "first profile in
  /// AppConfig order that has usable rules" — so this must reproduce the JSON
  /// array order exactly.
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
