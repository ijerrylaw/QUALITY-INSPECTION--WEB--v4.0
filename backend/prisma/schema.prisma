// ============================================================
// QUALITY INSPECTION (WEB) v4.0 — Prisma Schema
// Source of Truth: V4_MASTER_BLUEPRINT.md § 4 (Core Data Structures)
// ORM:      Prisma 7 (Early Access)
// Provider: SQLite (dev) — swap datasource.url for PostgreSQL in prod
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}


// ============================================================
// SUBMISSION
// Maps to: export interface Submission
// The central record of a single AQL inspection session.
// ============================================================
model Submission {
  /// Primary key — mirrors the `id: string` typed as 'sub_XXXXXXXXX'
  id                  String          @id @default(cuid())

  // --- Batch / Product Metadata ---
  productCode         String
  /// Full ISO 8601 datetime string (e.g. '2026-08-06T10:17:38.379Z') — the
  /// operator-editable effective production date/time used to derive the
  /// lot number's YJJJ component (ISO2859_MATH_ENGINE.md §4), NOT a bare
  /// date-only string despite the field name.
  productionDate      String
  /// Full ISO 8601 datetime string, same shape as productionDate — NOT a
  /// bare "HH:MM" string despite the field name. Usually equal to
  /// productionDate; can differ when the operator edits one without the
  /// other (e.g. amendment mode).
  samplingTime        String
  submissionTimestamp String          // ISO 8601 with ms precision, set by server
  machineId           String
  shift               String
  /// Full System Lot Number: [Line] + [Side] + [YJJJ] + [Sequence]
  /// (ISO2859_MATH_ENGINE.md §4), e.g. 'A001Z6221007'. Composed client-side
  /// from operator-selected Line/Side + the editable production date +
  /// a required, operator-entered Sequence (never auto-defaulted or
  /// auto-incremented — see StepMetadata.tsx/BatchEntry.tsx). This is NOT
  /// invented by the app: it must match what the company's ERP separately
  /// registers for the same physical lot, so composition is a convenience,
  /// not a guess. @unique is enforced here as the authoritative backstop
  /// behind the app-level uniqueness check in submissions.routes.ts.
  batchNumber         String          @unique
  size                String          // Glove size: 'XS' | 'S' | 'M' | 'L' | 'XL'
  sampleSize          Int

  // --- Measurement Data (stored as JSON blobs) ---
  // Raw per-slot measurement strings entered via numpad, keyed by dynamic
  // dimension id (not a fixed thickness/length shape — see ProductDimensionDef).
  dimensions          String          // JSON — DimensionMeasurements = Record<string, string[]>

  // Despite the name, stores the full per-dimension stats object (min/max/avg/
  // fails/thresholds) computed client-side at measurement time, NOT minimums —
  // legacy field name kept for backward compatibility. See DATA_SCHEMAS_AND_TYPES.md
  // §1 DimensionStats / AUDIT_REPORT.md §5.11.
  dimensionMins       String          // JSON — DimensionStats

  // DefectCounts: Record<DefectId, number>
  defects             String          // JSON — Record<string, number>

  // --- Verdict & Compliance ---
  verdict             String          // 'PASSED' | 'FAILED'

  // --- Submitting-user identity (mixed model) ---
  // Exactly ONE side is populated per row, decided by the login method that
  // created it: a PIN login sets `pinUserId` (a real FK); an M365/SSO login
  // sets the three string fields below. Both sides are nullable because
  // neither applies universally. Rows created before this model existed have
  // the SSO strings populated with hardcoded placeholder literals and
  // `pinUserId` null — deliberately left untouched, not backfilled.

  /// Azure AD Object ID from the MS365 token — SSO-originated rows only.
  aadObjectId         String?
  /// UPN (email) from the MS365 token — SSO-originated rows only. Always a
  /// true UPN/email, never a display name (see `displayName` below).
  userPrincipalName   String?
  /// Human-readable name of the SSO user, captured at submit time so history
  /// stays readable without a live Azure AD lookup. Kept separate from
  /// `userPrincipalName` so that field keeps meaning strictly "the UPN".
  /// SSO-originated rows only — for PIN rows the name comes from PinUser.name.
  displayName         String?

  /// FK to the PinUser who submitted — PIN-originated rows only.
  pinUserId           String?
  pinUser             PinUser?        @relation("SubmissionPinUser", fields: [pinUserId], references: [id])

  // --- Amendment Workflow ---
  amendmentStatus     String          @default("UNMODIFIED")
  // AmendmentStatus: 'UNMODIFIED' | 'AMENDMENT_DRAFTED' | 'PENDING_APPROVAL' | 'APPROVED' | 'REJECTED'

  // --- Optional Fields ---
  totalCarton         Int?
  gloveWeight         Float?

  // --- Profile Reference ---
  /// Opaque historical reference to whichever AppConfig.inspectionProfiles[]
  /// entry was in effect at submit time. No enforced referential integrity —
  /// real profiles live in AppConfig's JSON blob, not a relational table
  /// (see AUDIT_REPORT.md §8.4/§9.3). The FK relation to a dedicated
  /// InspectionProfile table was removed deliberately — see §9.3 Option B /
  /// §10 Part 3.
  profileId           String?

  /// Full per-category AQL analysis frozen at submit time (or refrozen at
  /// amendment-approval time, in the same transaction as `verdict`) — a
  /// self-contained snapshot, no live profile lookup needed to render it.
  /// JSON — FrozenCategoryAnalysis[] (backend/src/engine/resolveVerdict.ts).
  /// Null on rows predating this field ("legacy") — deliberately NOT
  /// backfilled (see AUDIT_REPORT.md finding #18); HistoryFeed.tsx falls
  /// back to a live re-grade with an explicit warning label for those.
  gradingSnapshot            String?
  /// Resolved profile display name captured at freeze time, so the panel
  /// can render it without a live profile lookup. Always set together
  /// with gradingSnapshot (both null or both set).
  gradingSnapshotProfileName String?

  // --- Relations ---
  amendmentLogs       AmendmentLog[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([productCode])
  @@index([submissionTimestamp])
  @@index([machineId, shift])
  @@index([amendmentStatus])
  @@index([pinUserId])
}

// ============================================================
// AMENDMENT LOG
// Maps to: export interface AmendmentLog (implied by Submission.amendmentLogs)
// An immutable audit trail entry for every change made after submission.
// ============================================================
model AmendmentLog {
  id              String      @id @default(cuid())

  submissionId    String
  submission      Submission  @relation(fields: [submissionId], references: [id])

  /// Serialized JSON snapshot of the original field values before the amendment
  originalValues  String      // JSON — Partial<Submission>

  /// Serialized JSON snapshot of the proposed new field values
  newValues       String      // JSON — Partial<Submission>

  // --- Requester identity (mixed model — see Submission's identity block) ---
  // Exactly one side is populated: `requestedByPinUserId` for a PIN login, or
  // `requestedBy`/`requestedByDisplayName` for an M365/SSO login.

  /// Who authored the amendment draft — true UPN/email, SSO-originated only.
  requestedBy     String?
  /// Human-readable name of the SSO requester, captured at draft time.
  requestedByDisplayName String?
  /// FK to the PinUser who authored the draft — PIN-originated only.
  requestedByPinUserId   String?
  requestedByPinUser     PinUser? @relation("AmendmentRequestedByPinUser", fields: [requestedByPinUserId], references: [id])
  requestedAt     String      // ISO 8601 timestamp

  // --- Reviewer identity (same mixed model as the requester above) ---

  /// Who approved or rejected — true UPN/email, SSO-originated only.
  reviewedBy      String?
  /// Human-readable name of the SSO reviewer, captured at review time.
  reviewedByDisplayName  String?
  /// FK to the PinUser who reviewed — PIN-originated only.
  reviewedByPinUserId    String?
  reviewedByPinUser      PinUser? @relation("AmendmentReviewedByPinUser", fields: [reviewedByPinUserId], references: [id])
  reviewedAt      String?     // ISO 8601 timestamp

  /// 'PENDING_APPROVAL' | 'APPROVED' | 'REJECTED'
  status          String      @default("PENDING_APPROVAL")

  /// Optional notes/reason supplied by the Supervisor
  supervisorNote  String?

  /// Server-recomputed verdict via resolveVerdict() — 'PASSED' | 'FAILED'.
  /// Set at draft time (informational) and overwritten at approval time
  /// (authoritative — this is what actually gets persisted to Submission.verdict).
  /// Null on rows created before this audit trail existed.
  recomputedVerdict          String?

  /// JSON — CategoryResult[] audit breakdown backing recomputedVerdict.
  recomputedCategoryResults  String?

  /// Count of physical dimensions with at least one out-of-spec measurement
  /// slot, from the server-side dimension recompute (§5.9 fix) — folded into
  /// recomputedVerdict via (AQL FAILED) OR (recomputedFailedDimensions > 0).
  /// Null on rows created before this audit trail existed.
  recomputedFailedDimensions Int?

  /// JSON — DimensionResult[] audit breakdown explaining recomputedFailedDimensions,
  /// same role as recomputedCategoryResults but for the dimension half of the verdict.
  recomputedDimensionResults String?

  createdAt       DateTime    @default(now())

  @@index([submissionId])
  @@index([requestedByPinUserId])
  @@index([reviewedByPinUserId])
}

// ============================================================
// InspectionProfile / AQLCategory / DefectDefinition models removed
// (AUDIT_REPORT.md §9.3 Option B / §10 Part 3) — they sat fully unused
// (0 rows) since real profile/category/defect data has only ever lived
// in AppConfig.inspectionProfiles JSON. See AUDIT_REPORT.md §8.4/§9.3 for
// the effort/tradeoff analysis behind this decision.
// ============================================================

// ============================================================
// PIN USER
// Self-managed PIN logins for high-turnover floor staff who don't have
// company email/Microsoft accounts (AUDIT_REPORT.md §11). Group A/B
// (managers) create and deactivate these; the PIN itself authenticates
// via POST /api/auth/pin-login. `role` is restricted server-side to the
// three PIN-eligible roles (OPERATOR/LEADER/SUPERVISOR — the "no email" /
// "PIN fallback" roles per NAVIGATION_AND_RBAC.md §2); `jobTitle` is the
// free-text real title, kept separate from `role` so audit trails retain
// the real title rather than collapsing it down to the role/group.
// ============================================================
model PinUser {
  id        String   @id @default(cuid())
  name      String
  /// Company-assigned employee ID — a second identity key alongside `id`,
  /// required + globally unique (@unique enforced at the DB level, mirrors
  /// Submission.batchNumber's two-layer pattern: app-level findFirst
  /// pre-check backed by this constraint as the atomic race-condition
  /// backstop — see pinUsers.routes.ts). Always stored uppercase (no
  /// enforced format/pattern — different customers use different employee
  /// ID schemes). Editable after creation by Group A/B via PATCH
  /// /api/pin-users/:id — the sole exception to PinUser's otherwise
  /// deliberate no-edit rule (NAVIGATION_AND_RBAC.md); never editable by
  /// the PIN user themselves (they have no authenticated session that
  /// reaches this route).
  employeeId String  @unique
  jobTitle  String
  /// 'OPERATOR' | 'LEADER' | 'SUPERVISOR' | 'INTERN' — enforced in route validation, not the DB
  role      String

  /// scrypt hash of the 6-digit PIN — see backend/src/lib/pin.ts
  pinHash   String
  /// Per-record random salt used to compute pinHash
  pinSalt   String

  /// Deactivated users are kept (not deleted) for audit history; their PIN
  /// becomes free for reuse since uniqueness is only enforced among active rows.
  active    Boolean  @default(true)

  // --- Back-relations (required by Prisma for the named relations below) ---
  // These make PIN-originated work attributable to a real person. Never
  // include these (or this model) in an API response without an explicit
  // `select` — PinUser carries pinHash/pinSalt, which must never be
  // serialized to a client.
  submissions       Submission[]   @relation("SubmissionPinUser")
  amendmentRequests AmendmentLog[] @relation("AmendmentRequestedByPinUser")
  amendmentReviews  AmendmentLog[] @relation("AmendmentReviewedByPinUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// ============================================================
// M365 USER ROLE
// aadObjectId -> role mapping for real Entra ID SSO logins (Group A/B/C —
// ADMIN/MANAGER/SUPERVISOR). A row can now be created two ways:
// auto-provisioned with role: null on a user's first successful MSAL
// login (POST /api/auth/m365-login), or pre-registered by a Group A admin
// via POST /api/m365-users/invite (role set, aadObjectId null, claimed on
// that person's first login). An admin (Group A, /system) assigns/changes
// a role via PATCH /api/m365-users/:id. Mirrors the PinUser pattern but
// for SSO users, who have no PinUser row of their own.
//
// State model — (aadObjectId, role, isActive) fully and unambiguously
// distinguish every reachable state, no separate status field needed:
//   aadObjectId set,  role null,     isActive true  → pending (Access Pending screen)
//   aadObjectId null, role set,      isActive true  → invited, not yet claimed
//   aadObjectId null, role set,      isActive false → invite revoked before claim
//   aadObjectId set,  role set,      isActive true  → fully active assigned user
//   aadObjectId set,  role set,      isActive false → deactivated
// (aadObjectId null + role null is never written by any code path.)
// ============================================================
model M365UserRole {
  id                String   @id @default(cuid())
  /// Null for an invited-but-unclaimed row (pre-registered by email, no
  /// login yet); set on that person's first login (claims the invite) or
  /// immediately for a never-invited first-time login. SQLite/libsql permit
  /// multiple NULLs under a UNIQUE index, so any number of unclaimed
  /// invited rows can coexist without collision.
  aadObjectId       String?  @unique
  /// Globally unique — the one field that identifies a person before
  /// they've ever logged in (invited row) as well as after.
  userPrincipalName String   @unique
  displayName       String
  /// Real job title from Microsoft Graph (GET /v1.0/me?$select=jobTitle),
  /// captured/refreshed on every login the same way displayName already
  /// is — display/audit only, NEVER read by any permission check (same
  /// rule as PinUser.jobTitle, NAVIGATION_AND_RBAC.md). Null for an
  /// unclaimed invite (never logged in yet, no Graph data) or if Graph
  /// genuinely never returned one; a transient Graph failure on a later
  /// login never blanks out a previously captured value — the route only
  /// overwrites this field when the incoming login actually supplies one.
  jobTitle          String?

  /// null = pending assignment (no access yet, only reachable via a bare
  /// first login, never via invite). 'ADMIN' | 'MANAGER' | 'SUPERVISOR'
  /// once set — enforced in route validation, not the DB (same convention
  /// as PinUser.role).
  role              String?

  /// Mirrors PinUser.active. False = access revoked (a claimed user who
  /// was deactivated) or an invite revoked before it was ever claimed.
  /// Distinct from role: null ("never assigned yet") — isActive false
  /// means "was/would-be granted a role, but access is off right now."
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

// ============================================================
// APP CONFIG
// Maps to: export interface AppConfig
// A SINGLETON table (only one row should ever exist).
// Stores all dynamic, hot-swappable system configuration.
// Lists and SKU builder dictionaries are stored as JSON blobs.
// ============================================================
model AppConfig {
  /// Singleton sentinel — always '1'
  id                  String   @id @default("1")

  // --- Simple string/number array lists (stored as JSON) ---
  /// JSON: string[] — e.g., ['N035SKB-OC-24FT', 'N100FNB-EC-9.5IN']
  productCodes        String   @default("[]")

  /// JSON: { id: string; name: string }[]
  lines               String   @default("[]")

  /// JSON: { id: string; name: string }[]
  shifts              String   @default("[]")

  /// JSON: { id: string; name: string }[]
  sides               String   @default("[]")

  /// JSON: string[] — e.g., ['XS', 'S', 'M', 'L', 'XL']
  sizes               String   @default("[]")

  /// JSON: number[] — valid AQL sample sizes, e.g. [13, 20, 32, 50, 80, 125, 200]
  sampleSizes         String   @default("[]")

  // --- Product to Profile Mapping ---
  /// JSON: Record<productCode, profileId>
  productProfileMap   String   @default("{}")

  // --- Branding (Blueprint Section 8: Dynamic White-Label) ---
  /// Company display name, e.g., 'GLOVE CORP'
  companyName         String   @default("QUALITY INSPECTION")
  /// Portal tab title
  portalTitle         String   @default("QI Portal v4.0")
  /// Base64 or URL of corporate logo
  logoImage           String?
  /// Primary accent colour token — one of the 5 named presets in
  /// frontend/src/lib/accentColors.ts: 'cobalt' | 'emerald' | 'violet' |
  /// 'amber' | 'rose'. Default is 'cobalt', not 'emerald' — matches the
  /// app's actual shipped visual identity (index.css's brand-primary/
  /// -secondary @theme values), so a fresh install with this field never
  /// explicitly set looks identical to today's app, not accidentally green.
  accentColor         String   @default("cobalt")

  // --- SKU Builder Dictionaries (Blueprint Section 5 / Section 7) ---
  /// JSON: { value: string; label: string }[]
  skuMaterials        String   @default("[]")
  /// JSON: { value: string; label: string }[]
  skuWeights          String   @default("[]")
  /// JSON: { value: string; label: string }[]
  skuColors           String   @default("[]")
  /// JSON: { value: string; label: string }[]
  skuTreatments       String   @default("[]")
  /// JSON: { value: string; label: string }[]
  skuLengths          String   @default("[]")
  /// JSON: { value: string; label: string }[]
  skuTextures         String   @default("[]")

  // --- Dynamic Configuration Data ---
  dimensions          String   @default("[]")
  targetWeight        String   @default("{\"target\":0,\"tolerance\":0}")
  productMatrixConfig String   @default("{}")
  aqlCategories       String   @default("[]")
  defectDefinitions   String   @default("[]")
  inspectionProfiles  String   @default("[]")

  // --- Consolidated Product Record (additive, Session A — see Product Engine
  // discovery report §2/§5 and the productProfileMap corrupted-key incident
  // in CHANGELOG.md). Migrates the three independently-keyed structures
  // above (productCodes / productMatrixConfig / productProfileMap) plus the
  // six SKU dictionary attributes (previously discarded after composing the
  // code string) into ONE per-code record, eliminating the three-way drift
  // risk. Additive only: nothing reads from this field yet — the three
  // structures above remain the live source of truth until a later session
  // rewires call sites onto this one and removes them. ---
  /// JSON: Record<productCode, ProductEntry> — see DATA_SCHEMAS_AND_TYPES.md §3.
  products            String   @default("{}")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // --- Cross-user runtime state (not "configuration" in the editable-by-
  // admin sense, but piggybacks on this table since it's the only global
  // singleton — see GET/POST /api/submissions/new-indicator|mark-history-viewed) ---
  /// Global (not per-user) — last time ANY user viewed Inspection Records.
  /// Compared against Submission.createdAt to drive the sidebar "new lot"
  /// dot + row badges; a new calendar day also implicitly clears it (see
  /// GET /api/submissions/new-indicator's effectiveLastViewedAt calc).
  lastHistoryViewedAt DateTime?
}
