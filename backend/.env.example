# Backend environment template — copy to backend/.env and edit.
# backend/.env is gitignored (backend/.gitignore); this template is the only
# version that ships (INSTALLER_PACKAGE_MANIFEST.md §1). Placeholder values
# only — never put real certs, keys, or secrets in this file.
#
# server.ts loads this file via `import 'dotenv/config'`. Every variable below
# is OPTIONAL except DATABASE_URL: the defaults baked into server.ts reproduce
# the original laptop dev setup exactly, so local dev works with none of them set.

# ── Database ─────────────────────────────────────────────────────────────────
# Prisma connection string. Local dev uses the SQLite file in backend/.
DATABASE_URL="file:./dev.db"

# ── Runtime ──────────────────────────────────────────────────────────────────
# Set to "production" on a real server. Also gates the dev-only /api/dev
# destructive-tools router, which is never mounted when this is "production".
# NODE_ENV=production

# ── Host & TLS ───────────────────────────────────────────────────────────────
# Bind address for the HTTPS listener. Default 0.0.0.0 (all interfaces).
# Set to a specific NIC address to restrict which network the API answers on.
# HOST=0.0.0.0

# Listen port. Default 4009.
# NOTE: the frontend also reads PORT (frontend/vite.config.ts, default 4001).
# Root `npm run dev` starts both with the same environment, so setting PORT in
# a shared shell/service environment moves BOTH servers. Set it per-process.
# PORT=4009

# TLS material for the HTTPS listener. Defaults are this laptop's
# mkcert-generated pair: frontend/10.10.110.31+1-key.pem and
# frontend/10.10.110.31+1.pem (one cert covering `localhost` + the static LAN
# IP). HTTPS is mandatory, not optional — Entra ID only permits HTTPS redirect
# URIs for any non-`localhost` host.
#
# A relative path resolves against the REPO ROOT (the parent of backend/);
# an absolute path is used as-is. frontend/vite.config.ts resolves these two
# variables against the same repo root, so one value serves both processes.
#
# On another server: generate/obtain a cert whose SAN list covers every
# hostname and IP that browser will use to reach the app, install its CA as
# trusted on the client machines, and point these at it. The .pem files
# themselves are gitignored and are never committed or packaged.
# TLS_KEY_PATH=C:\ProgramData\QualityInspection\certs\server-key.pem
# TLS_CERT_PATH=C:\ProgramData\QualityInspection\certs\server.pem
